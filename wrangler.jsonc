{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "caretag",
  "main": "geofence-dashboard/worker/index.js",
  "compatibility_date": "2026-10-01",
  "build": {
    "command": "npm install && npm run build",
    "cwd": "geofence-dashboard"
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "geofence-dashboard/build",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "CARETAG_KV",
      "id": "f2b433a0757c4517bf4e73298cbb5b54"
    }
  ]
}
