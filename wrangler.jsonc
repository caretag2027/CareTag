{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "caretag",
  "main": "geofence-dashboard/worker/index.js",
  "compatibility_date": "2026-10-01",
  "build": {
    "command": "npm install && npm run build",
    "cwd": "geofence-dashboard"
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "geofence-dashboard/build",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "CARETAG_KV",
      "id": "c4bc3f919a1c4d51b70854c6eeedc6e0"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "FIREBASE_AUTH_DOMAIN": "smart-band-7de19.firebaseapp.com",
    "FIREBASE_DATABASE_URL": "https://smart-band-7de19-default-rtdb.asia-southeast1.firebasedatabase.app",
    "FIREBASE_PROJECT_ID": "smart-band-7de19",
    "FIREBASE_STORAGE_BUCKET": "smart-band-7de19.firebasestorage.app",
    "FIREBASE_MESSAGING_SENDER_ID": "673896145526",
    "FIREBASE_APP_ID": "1:673896145526:web:199737a1183586dfb6f557",
    "FIREBASE_MEASUREMENT_ID": "G-9M1VLF71W2",
    "FIREBASE_USER_UID": "V68ovsSKeqRlyIdh2xoJV7EizVq1"
  }
}
